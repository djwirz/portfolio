---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { backedBy, caseStudyTitle, projectSlug, projectStories } from "../../lib/record";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  return studies.filter((s) => !projectStories.has(s.id)).map((study) => ({ params: { story: study.id }, props: { study } }));
}

const { study } = Astro.props;
const title = caseStudyTitle(study.body);
const { Content } = await render(study);
const proofs = backedBy(study.id);
---
<Base title={title} description={`A case study from employer work: ${title}.`}>
  <p class="text-sm text-muted-foreground">Experience · employer work, told without code</p>
  {proofs.length > 0 && (
    <p class="mt-4 text-sm">
      Proved in public by:{" "}
      {proofs.map((p, i) => (
        <>{i > 0 && ", "}<a href={`/work/${projectSlug(p.name)}/`} class="font-medium underline underline-offset-2">{p.name}</a></>
      ))}
    </p>
  )}
  <div class="prose case-study mt-6"><Content /></div>
</Base>
